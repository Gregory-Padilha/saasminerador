# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (NEVER commit secrets or API keys)
.env
.env*
*.env
**/.env*
web-ui/.env*
web-ui/.env.save

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
*/.venv/
venv/
*/venv/
*.pkl

# Local runtime data & caches
/.data/
/scratch/
/tmp/
web-ui/tmp/
*.zip
*.tar.gz

# Local media uploads & scraper diagnostics
/public/uploads/*
!/public/uploads/.gitkeep
/public/diagnostics/*
!/public/diagnostics/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# supabase temp
supabase/.temp/
